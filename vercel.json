{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "realai-app": {
      "root": "public/realai-elite-legacy/realai-app",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "APP_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}